/* design/tokens.css */
:root {
  /* Цвет */
  --c-black:      #000000;
  --c-white:      #FFFFFF;
  --c-grey:       #9E9E9E;
  --c-grey-light: #F2F2F2;
  --c-accent:     #B0E200;
  --c-accent-dim: #9BC900;
